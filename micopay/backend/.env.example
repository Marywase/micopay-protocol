# Micopay Backend — Local Environment Example

PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/micopay_dev

# Stellar Config
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=TESTNET
ESCROW_CONTRACT_ID=C... (Tu contrato desplegado)

# Security
JWT_SECRET=super_secret_jwt_key_for_hackathon
SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Firebase / FCM (for merchant push notifications)
# Download service account from Firebase Console →
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# OR: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./config/firebase-service-account.json

# MVP FLAGS
# Set to 'true' to skip real on-chain verification during the demo
MOCK_STELLAR=true

# Rate limits (#82)
CLIENT_ERROR_RATE_LIMIT_WINDOW_MS=60000
CLIENT_ERROR_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=5
TRADE_RATE_LIMIT_WINDOW_MS=3600000
TRADE_RATE_LIMIT_MAX=10
MESSAGE_RATE_LIMIT_WINDOW_MS=60000
MESSAGE_RATE_LIMIT_MAX=30
DISPUTE_RATE_LIMIT_WINDOW_MS=3600000
DISPUTE_RATE_LIMIT_MAX=5
DEVICE_RATE_LIMIT_MAX=15
IP_RATE_LIMIT_MAX=20

# Tiered KYC gate (#314) + monthly cumulative volume caps (#316). Audit-only
# (never blocks) until KYC_GATE_ENABLED=true — thresholds/ceilings below are
# PROVISIONAL pending legal dictamen review. See docs/GRANTFOX_KYC_QUEUE_2026-07.md.
KYC_GATE_ENABLED=false
KYC_LEVEL_EXPIRY_DAYS=365
# KYC_OPERATION_THRESHOLDS_JSON={"p2p_transfer":[{"maxAmountMxn":3000,"requiredLevel":1},{"maxAmountMxn":null,"requiredLevel":2}]}
# KYC_MONTHLY_VOLUME_CEILINGS_MXN_JSON={"0":0,"1":10000,"2":null}

# Abuse controls (#82)
BUYER_DAILY_TRADE_MAX=20
BUYER_DAILY_AMOUNT_MXN_MAX=100000
CANCEL_COOLDOWN_WINDOW_MS=3600000
CANCEL_COOLDOWN_THRESHOLD=3
CANCEL_COOLDOWN_MS=300000
MERCHANT_CANCEL_PAUSE_THRESHOLD=5
MERCHANT_DISPUTE_PAUSE_THRESHOLD=3
ADMIN_API_KEY=change_me_in_production

# ── Etherfuse anchor (SPEI <-> CETES) ───────────────────────────────────────
# Sandbox: create an account at https://sandbox.etherfuse.com, then
# Account -> Manage Accounts -> Sandbox API Keys to generate a key.
ETHERFUSE_API_KEY=
ETHERFUSE_API_URL=https://api.sand.etherfuse.com   # production: https://api.etherfuse.com

# One secret per POST /ramp/webhook subscription (base64, returned once at
# creation time) — see docs/SPEI_ANCHOR_PLAN.md for how these were registered.
ETHERFUSE_WEBHOOK_SECRET_ORDER=
ETHERFUSE_WEBHOOK_SECRET_KYC=

# ── Didit (tiered KYC gate, #314/#315) ──────────────────────────────────────
# Free-tier sandbox: create your own account at https://business.didit.me,
# then Settings -> API Keys for the key, and Settings -> Workflows for the
# workflow ID used at session creation. Populates users.kyc_level 1/2 for
# #314's gate — separate from, and independent of, the Etherfuse flow above.
DIDIT_API_KEY=
DIDIT_API_URL=https://verification.didit.me
DIDIT_WORKFLOW_ID=
# Workflow del nivel 2 (el del nivel 1 + comprobante de domicilio). Sin el,
# pedir nivel 2 responde 503 en vez de caer al workflow del nivel 1.
DIDIT_WORKFLOW_ID_L2=

# Secret for the POST /defi/kyc/webhook/didit subscription (returned once at
# creation time in the Didit dashboard).
DIDIT_WEBHOOK_SECRET=

# ── Circuit breakers (src/lib/circuitBreaker.config.ts) ──────────────────────
# Optional; the defaults below apply when unset. Reads are retried on transient
# failures; POSTs and Stellar submissions are never blindly retried.
# STELLAR_RPC_TIMEOUT_MS=10000
# STELLAR_RPC_CB_THRESHOLD=50
# STELLAR_RPC_CB_RESET_MS=30000
# STELLAR_RPC_MAX_RETRIES=3
# STELLAR_RPC_RETRY_BASE_MS=2000
# STELLAR_RPC_RETRY_MAX_MS=10000
# ETHERFUSE_TIMEOUT_MS=15000
# ETHERFUSE_MAX_RETRIES=3
# ETHERFUSE_RETRY_BASE_MS=2000
# DIDIT_TIMEOUT_MS=20000
# DIDIT_CB_THRESHOLD=50
# DIDIT_CB_RESET_MS=60000
